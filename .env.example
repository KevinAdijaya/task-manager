# Application
APP_NAME="Task Manager API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_manager
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL is constructed from above in config.py
# For local dev without Docker, use: postgresql+asyncpg://postgres:postgres@localhost:5432/task_manager

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:5500"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100