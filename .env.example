# Application
APP_NAME="Task Manager API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database — Option A: full URL (Render/Railway set this automatically)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_manager

# Database — Option B: individual vars (used by docker-compose & CI)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_manager
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT Authentication
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:5500"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100